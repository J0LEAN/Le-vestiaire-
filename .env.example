# Copie ce fichier en ".env" pour travailler en local.

# Emplacement du fichier de base de données SQLite.
# En local : un fichier dans le dossier prisma/.
# Sur Railway : un fichier sur le volume, par ex. file:/data/vestiaire.db
DATABASE_URL="file:./dev.db"

# Mot de passe de l'espace admin (/admin). Choisis-en un long !
ADMIN_PASSWORD="change-moi"

# (Facultatif) Dossier des copies des photos d'articles.
# Par défaut : /data/images si le disque /data existe (Railway), sinon storage/images.
# IMAGES_DIR="./storage/images"

# Adresse publique du site (sans / à la fin). Sert au sitemap, à Pinterest
# et aux aperçus sur les réseaux sociaux.
SITE_URL="http://localhost:3000"
